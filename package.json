{
  "name": "scan-grade",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:github": "SG_BASE=/draft1/ vite build",
    "preview": "vite preview",
    "dataset:worksheet-curated": "node scripts/build_curated_worksheet_dataset.mjs",
    "dataset:worksheet-current": "node scripts/build_current_pipeline_dataset.mjs",
    "dataset:worksheet-centered": "node scripts/build_centered_digit_dataset.mjs",
    "dataset:worksheet-combined": "node scripts/build_combined_worksheet_dataset.mjs",
    "train:worksheet-model": "node scripts/build_curated_worksheet_dataset.mjs && .venv/bin/python3.13 scripts/train_worksheet_digits.py --cpu --dataset datasets/worksheet_digits_curated",
    "train:worksheet-model-current": "node scripts/build_current_pipeline_dataset.mjs && .venv/bin/python3.13 scripts/train_worksheet_digits.py --cpu --dataset datasets/worksheet_digits_current_pipeline",
    "train:digit-generalist": ".venv/bin/python3.13 scripts/train_generalized_digit_model.py",
    "train:digit-mlp-json": "node scripts/train_digit_mlp_json.mjs",
    "eval:digit-prototypes": "node scripts/eval_digit_prototypes.mjs",
    "eval:worksheet-models": "node scripts/eval_worksheet_models.mjs",
    "eval:uploaded-worksheets": "node scripts/eval_uploaded_worksheets.mjs",
    "eval:ipad-tta": "node scripts/eval_ipad_tta.mjs",
    "inspect:live-debug-crops": "node scripts/inspect_live_debug_crops.mjs",
    "inspect:uploaded-worksheet": "node scripts/inspect_uploaded_worksheet.mjs",
    "eval:live-ocr-debug": ".venv/bin/python3.13 scripts/replay_live_ocr_debug.py",
    "eval:live-ocr-captured": "node scripts/replay_live_ocr_captured.mjs",
    "import:live-ocr-tensors": "node scripts/import_live_ocr_tensors.mjs",
    "dataset:student-samples": "node scripts/build_student_sample_dataset.mjs",
    "export:labeled-crops": "node scripts/export_labeled_crops.mjs",
    "dataset:split": "node scripts/build_dataset_split.mjs",
    "sanity:ocr-preprocess": "node scripts/run_ocr_sanity_set.mjs",
    "verify:softmax-confidence": "node scripts/verify-softmax-confidence.js"
  },
  "dependencies": {
    "canvas": "^3.2.1",
    "jsqr": "^1.4.0",
    "onnxruntime-web": "1.17.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "qrcode": "^1.5.4",
    "start-test": "^0.0.1",
    "vite": "^5.2.0",
    "vite-plugin-copy": "^0.1.6"
  }
}
